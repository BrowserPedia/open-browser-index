{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrowserPedia/open-browser-index/blob/main/schemas/browser.schema.json",
  "title": "Open Browser Index factual browser record",
  "description": "The public, source-linked factual shape. Editorial and site presentation fields are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "canonicalUrl", "publisher", "country", "sourceId", "status", "statusNote", "availability", "foundation", "privacy", "extensions", "workflow", "formFactor", "iosEngine", "ai", "mobile", "evidence", "firstPublished", "verifiedAt", "sources"],
  "properties": {
    "slug": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "canonicalUrl": { "$ref": "#/$defs/httpUrl" },
    "publisher": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "maintenance-mode", "experimental", "discontinued", "unsupported"] },
    "statusNote": { "type": "string", "minLength": 1 },
    "availability": {
      "type": "object", "additionalProperties": false,
      "required": ["macos", "windows", "linux", "android", "ios", "cpuNotes", "installMethod"],
      "properties": {
        "macos": { "$ref": "#/$defs/availabilityState" }, "windows": { "$ref": "#/$defs/availabilityState" }, "linux": { "$ref": "#/$defs/availabilityState" }, "android": { "$ref": "#/$defs/availabilityState" }, "ios": { "$ref": "#/$defs/availabilityState" },
        "cpuNotes": { "type": "string", "minLength": 1 }, "installMethod": { "type": "string", "minLength": 1 }
      }
    },
    "foundation": {
      "type": "object", "additionalProperties": false,
      "required": ["renderingEngine", "javascriptEngine", "upstreamProject", "codeLicense", "releaseChannel", "sourceRepository"],
      "properties": {
        "renderingEngine": { "enum": ["chromium", "gecko", "webkit", "goanna", "ladybird", "webview"] }, "javascriptEngine": { "type": "string", "minLength": 1 }, "upstreamProject": { "type": "string", "minLength": 1 }, "codeLicense": { "type": "string", "minLength": 1 }, "releaseChannel": { "enum": ["stable", "beta", "nightly", "rolling", "experimental"] }, "sourceRepository": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["telemetry", "trackerBlocking", "fingerprintingProtections", "privateWindows", "defaultSearchEngine", "vpnOrProxy"],
      "properties": { "telemetry": { "$ref": "#/$defs/state" }, "trackerBlocking": { "$ref": "#/$defs/state" }, "fingerprintingProtections": { "$ref": "#/$defs/state" }, "privateWindows": { "type": "string", "minLength": 1 }, "defaultSearchEngine": { "type": "string", "minLength": 1 }, "vpnOrProxy": { "$ref": "#/$defs/state" } }
    },
    "extensions": {
      "type": "object", "additionalProperties": false,
      "required": ["chromeWebStore", "firefoxAddons", "manifestV2", "manifestV3", "limitations", "nativeContentBlocking"],
      "properties": { "chromeWebStore": { "$ref": "#/$defs/extensionStoreState" }, "firefoxAddons": { "$ref": "#/$defs/extensionStoreState" }, "manifestV2": { "$ref": "#/$defs/state" }, "manifestV3": { "$ref": "#/$defs/state" }, "limitations": { "type": "string", "minLength": 1 }, "nativeContentBlocking": { "$ref": "#/$defs/state" } }
    },
    "workflow": { "$ref": "#/$defs/featureMap" },
    "formFactor": { "enum": ["desktop", "mobile", "cross-platform"] },
    "iosEngine": { "$ref": "#/$defs/iosEngineState" },
    "ai": { "$ref": "#/$defs/aiMap" },
    "mobile": { "$ref": "#/$defs/mobileMap" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "availability", "foundation", "privacy", "extensions", "workflow", "status"],
      "properties": { "identity": { "$ref": "#/$defs/sourceRefs" }, "availability": { "$ref": "#/$defs/sourceRefs" }, "foundation": { "$ref": "#/$defs/sourceRefs" }, "privacy": { "$ref": "#/$defs/sourceRefs" }, "extensions": { "$ref": "#/$defs/sourceRefs" }, "workflow": { "$ref": "#/$defs/sourceRefs" }, "status": { "$ref": "#/$defs/sourceRefs" } }
    },
    "firstPublished": { "$ref": "#/$defs/date" },
    "verifiedAt": { "$ref": "#/$defs/date" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source": { "type": "object", "additionalProperties": false, "required": ["id", "label", "url", "verifiedAt", "note"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "url": { "$ref": "#/$defs/httpUrl" }, "verifiedAt": { "$ref": "#/$defs/date" }, "note": { "type": "string", "minLength": 1 } } },
    "state": { "type": "object", "additionalProperties": false, "required": ["value", "note", "sourceRefs"], "properties": { "value": { "enum": ["built-in", "available-by-extension", "minimal-or-opt-in", "not-applicable", "unavailable", "unknown"] }, "note": { "type": "string", "minLength": 1 }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } } },
    "availabilityState": { "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "enum": ["available", "partial", "unavailable", "unknown"] } } }] },
    "iosEngineState": { "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "enum": ["webkit-required", "own-engine-permitted-not-shipped", "own-engine-shipped", "not-applicable", "unknown"] } } }] },
    "extensionStoreState": { "enum": ["supported", "partial", "unsupported", "unknown"] },
    "featureMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/state" }, "minProperties": 1 },
    "aiMap": { "$ref": "#/$defs/featureMap" },
    "mobileMap": { "$ref": "#/$defs/featureMap" }
  }
}
